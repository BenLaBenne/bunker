# ============================================================
# BUNKER — Variables d'environnement
# Copiez ce fichier en `.env` pour le développement local,
# ou définissez ces variables dans Render (Production).
# ============================================================

# --- Serveur ---
PORT=3000
NODE_ENV=development            # development | production

# --- Base de données ---
# Option A : URL complète (recommandé en production)
# Exemple Alwaysdata PostgreSQL :
# DATABASE_URL=postgres://compte_user:motdepasse@compte.pg.alwaysdata.net:5432/compte_bunker
# Option B : variables séparées
# DB_HOST=compte.pg.alwaysdata.net
# DB_PORT=5432
# DB_NAME=compte_bunker
# DB_USER=compte_user
# DB_PASSWORD=motdepasse
DB_SSL=true                     # SSL pour la connexion Postgres (true chez Alwaysdata)
# DB_DRIVER=sqlite              # Optionnel : force SQLite (dev local uniquement, fichier data/bunker.db)

# --- Sécurité ---
SESSION_SECRET=change-me-please-random-long-string
SESSION_DAYS=30

# --- Administration ---
# Premier compte inscrit = admin (choix retenu).
# Vous pouvez aussi forcer un compte admin existant au démarrage :
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
